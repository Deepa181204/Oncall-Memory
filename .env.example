# --- Hindsight (Cloud or self-hosted) ---
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=oncall-memory
MEMORY_BACKEND=hindsight

# --- LLM (Groq is OpenAI-compatible) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BACKEND=groq
LLM_TIMEOUT_SECONDS=30

# production requires both real providers; local/mock modes are only for offline demos
APP_ENV=development
APP_API_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
